# ============================================================
# Smart Store Management System — Backend Environment Variables
# ============================================================
# Copy this file to .env and configure the values below.

# --- Database (choose one) ---
# Option 1: MySQL (recommended for production)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/smart_store

# Option 2: Use SQLite automatically (set to true for development)
USE_SQLITE_FALLBACK=true

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- File Uploads ---
UPLOAD_DIR=./uploads/products
MAX_UPLOAD_SIZE_MB=5

# --- Store Branding ---
STORE_NAME=House of DNA
STORE_CURRENCY=INR
STORE_CURRENCY_SYMBOL=₹
